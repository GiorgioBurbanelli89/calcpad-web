'<div class="section"><b>C10. Plotly 3D surface</b></div>
'<div id="c10" style="width:500px; height:350px;" class="testbox"></div>
'<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
'<script>
'(function(){
'var div=document.getElementById("c10");
'if(typeof Plotly==="undefined"){div.textContent="Plotly no cargo";return;}
'var La='L', Lb='H', nx=30, nz=30;
'var xv=[], zv=[], yv=[];
'for(var i=0;i<=nx;i++){
'  var row=[], xr=[];
'  var x=i/nx*La;
'  for(var j=0;j<=nz;j++){
'    var z=j/nz*Lb;
'    row.push(-Math.sin(3.14159*x/La)*Math.sin(3.14159*z/Lb)*6.63);
'    xr.push(z);
'  }
'  xv.push(x); zv=xr; yv.push(row);
'}
'Plotly.newPlot(div,[{z:yv,x:zv,y:xv,type:"surface",colorscale:"Jet",showscale:true}],
'{title:"Deformada w(x,y) mm",scene:{xaxis:{title:"y(m)"},yaxis:{title:"x(m)"},zaxis:{title:"w(mm)"}},margin:{t:40,b:10,l:10,r:10}});
'})();
'</script>
